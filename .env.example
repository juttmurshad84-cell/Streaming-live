# ArenaLive — environment variables.  Copy to `.env.local` (dev) or set in your host's dashboard (prod).
# NEVER commit real values. Variables without NEXT_PUBLIC_ are server-only and are never sent to the browser.
# With none of these set the app still runs in clearly-labelled "development fixtures" mode (no accounts, no streaming).

# ── Site ────────────────────────────────────────────────────────────────────────
# Canonical public URL (used for auth e-mail links and absolute URLs). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on /contact and the legal pages. If unset, no address is displayed (none is invented).
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Supabase (database, auth, realtime, storage) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS: used for webhooks, provider fields, cron and admin tasks. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare Stream (live ingest, recording, playback) ───────────────────────
CLOUDFLARE_ACCOUNT_ID=
# API token with "Stream: Edit" on the account.
CLOUDFLARE_API_TOKEN=
# The "customer-<CODE>" part of https://customer-<CODE>.cloudflarestream.com (Stream dashboard).
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# Secret returned by `PUT /accounts/{id}/stream/webhook` (video "ready"/"error" webhooks, HMAC signed).
CLOUDFLARE_VIDEO_WEBHOOK_SECRET=
# Secret you choose when creating the Cloudflare Notifications webhook destination for live inputs
# (Cloudflare sends it back in the `cf-webhook-auth` header). Use a long random value.
CLOUDFLARE_LIVE_WEBHOOK_SECRET=

# ── Sports data (fixtures/scores only — this does NOT grant any broadcast rights) ──
SPORTS_PROVIDER=thesportsdb
# TheSportsDB key. The public free key "123" works for development (rate limited to 30 req/min).
SPORTS_API_KEY=

# ── Operations ─────────────────────────────────────────────────────────────────
# Required to call /api/cron/* (sent as `Authorization: Bearer <CRON_SECRET>`; Vercel Cron does this automatically).
# Generate with: openssl rand -hex 32
CRON_SECRET=
# Comma-separated hostnames whose generic <iframe> embeds are allowed as stream sources (YouTube is built in).
# Only list hosts you trust and whose terms permit embedding. Example: player.example.com,embed.partner.tv
APPROVED_EMBED_HOSTS=
# Optional: presence is only reported on /admin/integrations (no Sentry SDK is bundled).
SENTRY_DSN=
